# Contractor.AI local development configuration
#
# Local Compose starts without this file. Copy it to .env when you need to
# override the default local settings:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# Runtime files below are intentionally ignored by git.

NODE_ENV=development
PORT=3000

# Local is the supported day-to-day mode. Hosted mode requires the managed
# PostgreSQL and EU object-storage settings below before it will become ready.
CONTRACTOR_AI_RUNTIME_MODE=local
CONTRACTOR_AI_STORAGE_MODE=local
# Hosted only: managed EU PostgreSQL with sslmode=require or verify-full.
CONTRACTOR_AI_DATABASE_URL=
CONTRACTOR_AI_PUBLIC_URL=
CONTRACTOR_AI_HOSTING_PROVIDER=
CONTRACTOR_AI_HOSTING_REGION=
CONTRACTOR_AI_DATA_RESIDENCY=
CONTRACTOR_AI_DPA_REFERENCE=
CONTRACTOR_AI_POSTGRES_BACKUP_MODE=
CONTRACTOR_AI_OBJECT_VERSIONING_ENABLED=false
CONTRACTOR_AI_BACKUP_POLICY_REFERENCE=
CONTRACTOR_AI_RATE_WINDOW_MS=60000
CONTRACTOR_AI_RATE_LIMIT=240
CONTRACTOR_AI_RATE_BUCKET_LIMIT=5000
# Hosted only: exact HTTPS ingress proxy IP/CIDR entries. Never use true or a
# hop count; local mode leaves proxy trust disabled.
CONTRACTOR_AI_TRUST_PROXY=

# Durable ledger-only autonomous scheduler. Disabled by default for local use.
CONTRACTOR_AI_AUTONOMOUS_SCHEDULER_ENABLED=false
CONTRACTOR_AI_AUTONOMOUS_INTERVAL_SECONDS=300
CONTRACTOR_AI_AUTONOMOUS_LEASE_SECONDS=120

# Hosted evidence storage. These are deliberately blank for local operation.
# Use an EU-region, DPA-covered S3-compatible provider when hosted support is enabled.
CONTRACTOR_AI_S3_ENDPOINT=
CONTRACTOR_AI_S3_BUCKET=
CONTRACTOR_AI_S3_REGION=eu-central-1
CONTRACTOR_AI_S3_ACCESS_KEY_ID=
CONTRACTOR_AI_S3_SECRET_ACCESS_KEY=
CONTRACTOR_AI_S3_PREFIX=contractor-ai/evidence
# Readiness verifies PUT and GET access with one stable marker under the prefix.
CONTRACTOR_AI_STORAGE_TIMEOUT_MS=5000
CONTRACTOR_AI_STORAGE_VERIFY_TTL_MS=60000

# Local ledger storage. Keep this directory on an encrypted local disk.
# STATE_FILE is a deprecated one-time import source for a pre-ledger local
# install; it is never written by the active runtime. Leave it blank for new installs.
CONTRACTOR_AI_DATA_DIR=
STATE_FILE=
LEDGER_DB_FILE=./data/contractor-ledger.sqlite

# Local upload storage for field photos, documents, invoices, and evidence.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760

# Comma-separated browser origins allowed to call the local API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Keep local development open by default. Production always requires a strong
# token. Use at least 32 unpadded random characters; 32 random bytes is recommended.
# The dashboard exchanges it for a short-lived HTTP-only session. API clients
# can continue using Bearer, X-Contractor-AI-Token, X-API-Key, or Basic Auth.
CONTRACTOR_AI_REQUIRE_AUTH=false
CONTRACTOR_AI_AUTH_TOKEN=
CONTRACTOR_AI_SESSION_TTL_SECONDS=28800
CONTRACTOR_AI_LOGIN_RATE_WINDOW_MS=900000
CONTRACTOR_AI_LOGIN_RATE_LIMIT=10
# Optional production role-token map. Each token must have at least 32 unpadded random characters.
# A field worker must be scoped to a durable worker record or explicit job IDs.
# Preferred: {"operators":[{"id":"owner-main","name":"Owner","role":"owner","token":"..."},{"id":"field-piet","name":"Piet","role":"field_worker","token":"...","workerId":"worker_123"}]}
# Legacy role-keyed strings and objects remain supported. Role values may also be arrays of principals with stable ids.
CONTRACTOR_AI_ROLE_TOKENS=
# Comma-separated provider identifiers allowed to record delivery receipts
# after the matching outbound communication approval has been resolved.
CONTRACTOR_AI_VERIFIED_INTEGRATIONS=

# Live weather is fetched only when an operator requests an assessment. The
# default adapter uses Open-Meteo's public forecast and geocoding APIs without
# an API key. Set to false to require manually recorded weather assessments.
WEATHER_PROVIDER_ENABLED=true
WEATHER_PROVIDER_TIMEOUT_MS=8000
