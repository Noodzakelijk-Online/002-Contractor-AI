{
  "name": "contractor-ai-system",
  "version": "1.1.0",
  "description": "Advanced Contractor AI Automation System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "vite build",
    "dev": "vite",
    "dev:api": "node server.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "doctor": "node scripts/doctor.js",
    "verify:release": "node scripts/verify-release-contract.js",
    "verify:hai-contract": "node scripts/verify-hai-contract.js",
    "migrate:hosted": "node scripts/migrate-local-backup-to-hosted.js",
    "restore:local": "node scripts/restore-local-backup.js",
    "serve": "node server.js",
    "test": "node scripts/run-node-tests.js --test-concurrency=4",
    "test:frontend": "vitest run",
    "test:performance": "node scripts/benchmark-ledger.js --profile smoke --iterations 2",
    "benchmark:ledger": "node scripts/benchmark-ledger.js --profile production",
    "test:browser": "node scripts/run-browser-tests.js",
    "test:container": "node scripts/verify-container-runtime.js",
    "test:windows-package": "node scripts/verify-windows-standalone.js",
    "start:standalone": "node standalone-launcher.js",
    "start:tunnel": "node scripts/start-ngrok.js",
    "export:hai": "node scripts/export-hai-feed.js",
    "package:windows": "node scripts/build-windows-standalone.js",
    "verify:bundle": "node scripts/verify-bundle-budget.js"
  },
  "dependencies": {
    "@dagrejs/graphlib": "^4.0.1",
    "@ngrok/ngrok": "1.7.0",
    "compression": "1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "espree": "^11.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.23",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [
    "contractor",
    "ai",
    "automation",
    "business"
  ],
  "author": "Contractor AI Solutions",
  "license": "MIT"
}
