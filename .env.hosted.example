# Copy to .env.hosted and replace every placeholder before starting hosted mode.
# Keep this file non-secret; .env.hosted is ignored by Git.

PORT=3000
CONTRACTOR_AI_RUNTIME_MODE=hosted
CONTRACTOR_AI_STORAGE_MODE=s3
CONTRACTOR_AI_AUTH_TOKEN=replace-with-a-long-unique-owner-token
# Every owner or role token must contain at least 32 unpadded random characters.
CONTRACTOR_AI_PUBLIC_URL=https://contractor.example.eu
CONTRACTOR_AI_HOSTING_PROVIDER=replace-with-eu-provider-name
CONTRACTOR_AI_HOSTING_REGION=eu-central-1
CONTRACTOR_AI_DATA_RESIDENCY=EU
CONTRACTOR_AI_DPA_REFERENCE=replace-with-retained-dpa-reference
# Use a managed EU PostgreSQL service with TLS. Prefer verify-full with the
# provider trust chain; require is the minimum accepted encrypted mode.
CONTRACTOR_AI_DATABASE_URL=postgresql://contractor_ai:replace-with-a-long-unique-postgres-password@managed-postgres.example-provider.eu:5432/contractor_ai?sslmode=verify-full
# Operator principals: {"operators":[{"id":"owner-main","role":"owner","token":"..."},{"id":"field-piet","role":"field_worker","token":"...","workerId":"worker_123"}]}
CONTRACTOR_AI_ROLE_TOKENS=
CONTRACTOR_AI_VERIFIED_INTEGRATIONS=
CONTRACTOR_AI_REQUIRE_AUTH=true
CONTRACTOR_AI_SESSION_TTL_SECONDS=28800
CONTRACTOR_AI_LOGIN_RATE_WINDOW_MS=900000
CONTRACTOR_AI_LOGIN_RATE_LIMIT=10
CORS_ORIGINS=https://contractor.example.eu
# Replace with the exact ingress source IP or CIDR visible to the container.
# Boolean and hop-count trust rules are rejected to prevent forwarded-IP spoofing.
CONTRACTOR_AI_TRUST_PROXY=replace-with-ingress-proxy-ip-or-cidr
CONTRACTOR_AI_RATE_WINDOW_MS=60000
CONTRACTOR_AI_RATE_LIMIT=240
CONTRACTOR_AI_RATE_BUCKET_LIMIT=5000

# Use a private EU-resident bucket with encryption at rest and a signed DPA.
CONTRACTOR_AI_S3_ENDPOINT=https://s3.eu-central-1.example-provider.eu
CONTRACTOR_AI_S3_BUCKET=contractor-ai-private-evidence
CONTRACTOR_AI_S3_REGION=eu-central-1
CONTRACTOR_AI_S3_ACCESS_KEY_ID=replace-with-object-storage-access-key
CONTRACTOR_AI_S3_SECRET_ACCESS_KEY=replace-with-object-storage-secret
CONTRACTOR_AI_S3_PREFIX=contractor-ai/evidence
# Provider recovery is mandatory because the application cannot create a
# complete PostgreSQL and object-store package from inside the container.
CONTRACTOR_AI_POSTGRES_BACKUP_MODE=pitr
CONTRACTOR_AI_OBJECT_VERSIONING_ENABLED=true
CONTRACTOR_AI_BACKUP_POLICY_REFERENCE=replace-with-retained-recovery-policy-reference
CONTRACTOR_AI_RETENTION_POLICY_REFERENCE=replace-with-retained-retention-policy-reference
# Hosted startup and readiness verify PUT and GET access with one stable marker.
CONTRACTOR_AI_STORAGE_TIMEOUT_MS=5000
CONTRACTOR_AI_STORAGE_VERIFY_TTL_MS=60000

# Enable only after monitoring the persisted scheduler and approval queue.
CONTRACTOR_AI_AUTONOMOUS_SCHEDULER_ENABLED=false
CONTRACTOR_AI_AUTONOMOUS_INTERVAL_SECONDS=300
CONTRACTOR_AI_AUTONOMOUS_LEASE_SECONDS=120
CONTRACTOR_AI_RELEASE_SHA=replace-with-deployed-git-sha
